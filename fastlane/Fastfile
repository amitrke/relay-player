# Production releases and store listings. Test builds do not use fastlane: they
# go out through .github/workflows/release.yml. These lanes are run by
# .github/workflows/promote.yml; see docs/RELEASING.md, "Production".
#
# Adapted from amitrke/voice-notes, which adapted its release.yml from this
# repository. Promotion never builds anything. It sends the build testers
# already have (the same build number on both stores, since release.yml uses
# github.run_number for both) to production, so what ships is what was tested.
#
# Everything uploaded here is a public artefact: CLAUDE.md §1 and
# architecture.md §8.2 apply to the listing and the release notes as much as to
# the screenshots. Nothing names a provider or describes Advanced sources.

require "tmpdir"

opt_out_usage

# Lane code runs inside fastlane/, actions run from the repository root.
ROOT = File.expand_path("..", __dir__)
PUBSPEC = File.join(ROOT, "pubspec.yaml")
PLAY_METADATA = "fastlane/metadata/android"
IOS_METADATA = "fastlane/metadata/ios"
# One file of release notes per version, shared by both stores. release.yml
# already sends it to testers on Play; the lanes below reuse it for production
# on Play and for the App Store's "What's New", so the notes are written once.
CHANGELOGS = File.join(ROOT, PLAY_METADATA, "en-US", "changelogs")
PLAY_NOTES_LIMIT = 500
# deliver removes App Review attachments it is not given, so a recording for
# reviewers has to live here to survive a release.
REVIEW_ATTACHMENT = "fastlane/review_attachment.mp4"

def version_name
  name = File.read(PUBSPEC)[/^version:\s*([^+\s]+)/, 1]
  UI.user_error!("pubspec.yaml's version '#{name}' is not of the form 1.2.3") unless name.to_s.match?(/\A\d+\.\d+\.\d+\z/)
  name
end

def build_number(options)
  build = options[:build].to_s
  UI.user_error!("Pass build:<number>, the build number testers have (TestFlight and Play show it in brackets)") unless build.match?(/\A\d+\z/)
  build
end

# The notes for the version in pubspec. A production release without them is
# refused rather than shipped silent: App Store Connect requires "What's New"
# on every update, and a Play release with none shows users nothing.
def release_notes
  path = File.join(CHANGELOGS, "v#{version_name}.txt")
  UI.user_error!("No release notes for #{version_name}: write #{path.delete_prefix("#{ROOT}/")} first") unless File.exist?(path)
  notes = File.read(path, encoding: "utf-8").strip
  # Characters, not bytes, as release.yml counts them.
  UI.user_error!("#{File.basename(path)} is #{notes.length} characters; Play accepts at most #{PLAY_NOTES_LIMIT}") if notes.length > PLAY_NOTES_LIMIT
  notes
end

# A temporary copy of one store's metadata, so the release notes can be put
# where that store's tool looks for them without a second copy in the
# repository.
def metadata_copy(source)
  copy = File.join(Dir.mktmpdir("metadata"), File.basename(source))
  FileUtils.cp_r(File.join(ROOT, source), copy)
  copy
end

# Stops a promotion while Apple has a version of this app waiting for or in
# review. deliver counts a version "Waiting for Review" as the one to edit: on
# 2026-10-31 the first release found 1.0.6 (build 39) waiting, renamed it to
# 1.0.7, replaced its notes and listing, and only then failed, because Apple
# will not change the build of a version in review (docs/RELEASING.md). That
# left 1.0.6 code under 1.0.7's name and notes, in front of Apple. Checking
# first changes nothing. To replace a waiting version, remove it from review in
# App Store Connect, then run again.
def refuse_while_in_review
  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  UI.user_error!("App Store Connect has no app for this bundle ID") unless app
  # Both fields: Apple deprecated appStoreState for appVersionState, and
  # deliver's own lookup filters on the newer one.
  state = ->(v) { v.app_version_state || v.app_store_state }
  busy = app.get_app_store_versions(filter: { platform: "IOS" }).select do |v|
    %w[WAITING_FOR_REVIEW IN_REVIEW].include?(state.(v))
  end
  return if busy.empty?
  listed = busy.map { |v| "#{v.version_string} (#{state.(v)})" }.join(", ")
  UI.user_error!("Apple already has #{listed}. Remove it from review in App Store Connect first; nothing was changed")
end

# Shared by the iOS lanes.
def deliver_options(metadata_path: IOS_METADATA)
  options = {
    platform: "ios",
    app_version: version_name,
    metadata_path: metadata_path,
    skip_binary_upload: true,
    skip_screenshots: true,
    # No HTML preview to confirm: this runs unattended.
    force: true
  }
  options[:app_review_attachment_file] = REVIEW_ATTACHMENT if File.exist?(File.join(ROOT, REVIEW_ATTACHMENT))
  options
end

platform :android do
  desc "Promote a build from internal testing to production, with the listing and release notes"
  desc "Options: build:<number> (required), rollout:<percent> (default 100)"
  lane :promote do |options|
    rollout = (options[:rollout] || 100).to_f
    UI.user_error!("rollout must be a percentage above 0 and at most 100") unless rollout > 0 && rollout <= 100
    build = build_number(options)

    # supply reads changelogs/<versionCode>.txt for the release it creates.
    metadata = metadata_copy(PLAY_METADATA)
    File.write(File.join(metadata, "en-US", "changelogs", "#{build}.txt"), "#{release_notes}\n")

    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: build.to_i,
      rollout: (rollout / 100).to_s,
      metadata_path: metadata,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the store listing text only. It goes live once Google accepts it"
  lane :listing do
    upload_to_play_store(
      metadata_path: PLAY_METADATA,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Download the live listing into path:<dir>, to compare with the repository"
  lane :fetch_listing do |options|
    download_from_play_store(metadata_path: options[:path] || UI.user_error!("Pass path:<dir>"))
  end
end

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Submit a TestFlight build for App Review with the listing and release notes"
  desc "It goes live automatically once Apple approves it. Options: build:<number> (required)"
  lane :promote do |options|
    build = build_number(options)
    refuse_while_in_review
    metadata = metadata_copy(IOS_METADATA)
    File.write(File.join(metadata, "en-US", "release_notes.txt"), "#{release_notes}\n")

    deliver(
      deliver_options(metadata_path: metadata).merge(
        build_number: build,
        submit_for_review: true,
        automatic_release: true,
        # Apple's review is the check that matters, and precheck cannot read
        # in-app purchases with an API key anyway.
        run_precheck_before_submit: false,
        # No content-rights answer, unlike voice-notes, whose app shows nothing
        # but its own. This one exists to access third-party content (a Plex
        # server, a share, a source the user configures), and how that is
        # declared is an architecture.md §1 question already answered by hand in
        # App Store Connect at the first submission. Leaving it out keeps that
        # answer instead of a lane quietly overwriting it.
        submission_information: {
          add_id_info_uses_idfa: false
        }
      )
    )
  end

  desc "Upload the listing to the version being prepared (pubspec's version), without submitting it"
  lane :listing do
    deliver(deliver_options)
  end
end
