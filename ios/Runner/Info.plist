<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Subnext Player</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Subnext Player</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!--
	  Export compliance, declared here so TestFlight does not hold every build
	  for the question. NO means "only exempt encryption", which was checked
	  against the code on 2026-09-23 rather than assumed:
	  - network traffic is standard TLS (Plex, AI providers, HTTP sources);
	  - secrets go to the iOS Keychain via flutter_secure_storage, the OS's own;
	  - lib/ has no cipher code of its own;
	  - smb_connect's crypto is NTLM authentication and SMB message signing
	    only. Its own configuration says SMB encryption "is not implemented
	    yet" (isEncryptionEnabled = false).
	  Revisit if any of that changes, notably an smb_connect upgrade that adds
	  SMB3 encryption: encrypting content in transit is not the same exemption
	  as authenticating it. Not legal advice; this records what the app does.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Required, not optional: photo_manager asks for Photos access when the user
	  taps "Allow video access" on Local & Network (§7.1), and iOS terminates an
	  app that requests a privacy-protected resource with no usage string. That
	  is exactly what the first simulator run did (2026-09-23). Reading only; the
	  app never writes to the library, so there is no NSPhotoLibraryAdd key.
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Subnext Player shows the videos in your library so you can play them. It only reads videos and never changes or uploads anything.</string>
	<!--
	  iOS 14+ gates every LAN connection behind a Local Network prompt on real
	  hardware: SMB shares and a Plex server reached by its LAN address both
	  trigger it. Without this string the prompt shows a generic system message.
	  The simulator does not enforce the prompt, so this is unverified until a
	  device run (MANUAL_TESTING.md).
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Subnext Player connects to media servers and network shares on your home network, such as Plex or a NAS.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
